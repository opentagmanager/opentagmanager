# OSSTag Environment Configuration
# Copy this file to .env and fill in your values
# Required variables are marked with [REQUIRED]
# Optional variables have default values shown

# =============================================================================
# DATABASE (Required)
# =============================================================================

# PostgreSQL connection URL for the main application database
# Format: postgresql://user:password@host:port/database
# For local development with Docker: postgresql://osstag:omguseotm@localhost:5432/otm
OTM_DATABASE_URL=postgresql://osstag:omguseotm@localhost:5432/otm

# =============================================================================
# APP URL (Required)
# =============================================================================

# Base URL of your OSSTag instance
# Used for callbacks, links, and CORS configuration
# For local development: localhost:3000
# For production: https://your-domain.com
OTM_PROJECT_URL=localhost:3000

# =============================================================================
# SECURITY (Required)
# =============================================================================

# Pepper for hashing API keys (additional salt beyond bcrypt)
# MUST be changed in production! Generate with: openssl rand -hex 32
# This adds an extra layer of security to API key storage
OTM_API_KEY_PEPPER=please-change-me-to-a-long-random-string-of-at-least-32-chars

# Better Auth secret for JWT signing and encryption
# MUST be at least 32 characters long
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=superlongrandomsecretstringofatleast32chars

# Scrypt parameters for password hashing (adjust based on your server's CPU)
# These are secure defaults - only change if you know what you're doing
OTM_SCRYPT_N=16384      # CPU/memory cost parameter (higher = more secure, slower)
OTM_SCRYPT_R=8          # Block size parameter
OTM_SCRYPT_P=1          # Parallelization parameter
OTM_SCRYPT_MAXMEM=67108864  # Max memory in bytes (64MB)

# =============================================================================
# REDIS CACHE (Optional but recommended for production)
# =============================================================================

# Upstash Redis REST API URL for caching
# Sign up at https://upstash.com/ to get free tier
# Leave empty to use in-memory cache (suitable for local dev)
OTM_UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url

# Upstash Redis REST API token
# Found in your Upstash console under "REST API"
OTM_UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# =============================================================================
# VERCEL DEPLOYMENT (Auto-set by Vercel, only needed for local dev)
# =============================================================================

# Vercel environment identifier
# Options: development, preview, production
VERCEL_ENV=development
NEXT_PUBLIC_VERCEL_ENV=development

# =============================================================================
# RELAY / INGEST (Required)
# =============================================================================

# URL of the relay node for event collection
# This is the public endpoint that receives tracking events
# For local development: http://localhost:8787/collect
NEXT_PUBLIC_OTM_RELAY_URL=http://localhost:8787/collect

# Preview mode flag for testing tags before publishing
# Allows seeing draft tag configurations in your browser
NEXT_PUBLIC_OTM_PREVIEW_FLAG=otm_preview

# Internal ingest service URL (for dashboard to send test events)
OTM_INGEST_URL=http://localhost:4000/api/ingest

# =============================================================================
# OAUTH - GitHub (Optional - enable GitHub login)
# =============================================================================

# GitHub OAuth app credentials
# Create at: https://github.com/settings/developers
# Callback URL: https://your-domain.com/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# =============================================================================
# OAUTH - Google (Optional - enable Google login)
# =============================================================================

# Google OAuth 2.0 credentials
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =============================================================================
# GITHUB INTEGRATION (Optional - for import/export features)
# =============================================================================

# GitHub personal access token
# Used for syncing configs to GitHub repositories
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_********************************

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================

# Lock marketing page (show "coming soon" instead of full landing page)
# Set to 1 to enable lock, 0 to disable
OSSTAG_MARKETING_LOCK=0

# =============================================================================
# KAFKA / MESSAGE QUEUE (Required for production ingest)
# =============================================================================

# Kafka broker addresses (comma-separated for multiple)
# For local development with Docker: localhost:9092
KAFKA_BROKERS=localhost:9092

# Kafka security protocol
# Options: PLAINTEXT, SSL, SASL_PLAINTEXT, SASL_SSL
# Use PLAINTEXT for local dev, SSL for production
KAFKA_PROTOCOL=PLAINTEXT

# SASL mechanism for authentication (when using SASL_* protocols)
# Options: plain, scram-sha-256, scram-sha-512, none
KAFKA_MECHANISM=none

# Kafka topic name for ingest events
KAFKA_TOPIC_INGEST=osstag.ingest

# Kafka authentication credentials (when SASL is enabled)
KAFKA_USERNAME=osstag_ingest
KAFKA_PASSWORD=Osstag@2025

# Kafka client identifier (appears in Kafka logs/monitoring)
KAFKA_CLIENT_ID=osstag-relay

# Enable SSL for Kafka connections (true/false)
KAFKA_SSL=false

# Enable SASL authentication (true/false)
KAFKA_SASL_ENABLED=false

# =============================================================================
# RELAY NODE SETTINGS (Optional - fine-tune event processing)
# =============================================================================

# Relay metrics endpoint URL
RELAY_METRICS_URL=http://localhost:4000/metrics

# Timeout for metrics collection (milliseconds)
RELAY_METRICS_TIMEOUT_MS=1500

# Cache duration for metrics (milliseconds)
RELAY_METRICS_CACHE_MS=3000

# Max request body size (kilobytes) - prevents abuse
RELAY_MAX_BODY_KB=64

# Max events per request
RELAY_MAX_EVENTS=50

# Max clock skew allowed between client and server (milliseconds)
# Prevents replay attacks with old timestamps
RELAY_SKEW_MS=300000

# Max events to batch before flushing
RELAY_MAX_BATCH_SIZE=2000

# Interval to flush batched events (milliseconds)
RELAY_FLUSH_INTERVAL_MS=3000

# Max retry attempts for failed event delivery
RELAY_MAX_RETRY_ATTEMPTS=5

# Max S3 upload size for large event payloads (megabytes)
RELAY_S3_MAX_MB=1

# Admin key for relay management endpoints (rotate in production!)
RELAY_ADMIN_KEY=devadmin123

# Enable file logging (true/false) - logs to ./logs/ directory
LOG_TO_FILE=true

# =============================================================================
# CLICKHOUSE ANALYTICS (Optional - for advanced analytics)
# =============================================================================

# ClickHouse HTTP interface URL
# Used for storing and querying analytics data
# For local development: http://localhost:8123
CLICKHOUSE_URL=http://localhost:8123

# ClickHouse database name
CLICKHOUSE_DB=osstag

# ClickHouse username
CLICKHOUSE_USER=default

# ClickHouse password (leave empty for local dev without auth)
CLICKHOUSE_PASSWORD=

# =============================================================================
# S3 / OBJECT STORAGE (Optional - for event archiving)
# =============================================================================

# AWS S3 or compatible storage (MinIO, Wasabi, etc.)

# S3 region (use "local" for MinIO)
S3_REGION=local

# S3 bucket name
S3_BUCKET=local-bucket

# S3 access key ID
S3_ACCESS_KEY_ID=admin

# S3 secret access key
S3_SECRET_ACCESS_KEY=password

# S3 endpoint URL (for MinIO or other S3-compatible services)
# MinIO local: http://localhost:9100
# AWS S3: https://s3.amazonaws.com
S3_ENDPOINT=http://localhost:9100
